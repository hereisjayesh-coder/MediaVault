# Template for the release-signing config app/build.gradle.kts reads.
#
# Copy this file to keystore.properties (repo root) and fill in your real values there.
# keystore.properties is gitignored — it must never be committed, and neither must the
# .jks/.keystore file it points to. Without this file present, `assembleRelease` still
# builds successfully, just unsigned (exactly as it always has) — so a fresh checkout
# without these secrets is never broken, only unable to produce a signed release build.
#
# storeFile may be an absolute path, or relative to this file's own directory (the repo root).
storeFile=/absolute/path/to/your/release.jks
storePassword=changeit
keyAlias=changeit
keyPassword=changeit
